  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/static-build.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "wrangler dev --ip 0.0.0.0",
    "fixtures": "node --import tsx scripts/fixtures.ts",
    "format": "prettier --write src tests e2e scripts *.ts *.json *.md docs"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "dexie": "^4.0.11",
    "solid-js": "^1.9.9",
    "@solidjs/start": "^2.0.5",
    "@solidjs/meta": "^0.29.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.1.11",
    "nitro": "3.0.260903-beta",
    "workbox-build": "^7.4.1"
  }
