/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.openai.com; frame-src 'none'; media-src 'self' blob:; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  X-Frame-Options: DENY
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/_build/assets/*
  Cache-Control: public, max-age=31536000, immutable

/privacy
  Cache-Control: no-cache
/privacy/
  Cache-Control: no-cache
