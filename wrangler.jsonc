{
  "name": "ahthatswho",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": false,
  },
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "BACKUP_DB",
      "database_name": "ahthatswho-backups",
      "database_id": "2bdd76d7-da72-42d3-95fe-7b62d7f3e732",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "BACKUP_ORIGINS": "https://ahthatswho.com" },
  // Native branch previews are the default. Backup is intentionally out of scope.
  "previews": {
    "vars": { "BACKUP_ORIGINS": "" },
  },
}
