{
  "name": "ahthatswho",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
